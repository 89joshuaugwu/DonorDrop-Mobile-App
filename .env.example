# === Firebase (public config — safe to expose, matches your other Firebase projects) ===
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=donordrop-xxxxx.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=donordrop-xxxxx
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=donordrop-xxxxx.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<paste the Web client ID here>

# === Companion backend (donordrop-admin) — deploy that FIRST, then paste its Vercel URL here ===
# No trailing slash.
EXPO_PUBLIC_ADMIN_API_URL=https://donordrop.vercel.app
